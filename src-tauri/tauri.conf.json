{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PetSpector",
  "version": "0.1.0",
  "identifier": "com.petspector.app", 
  "build": {
    "beforeDevCommand": "flutter run -d chrome --web-port 8080 --web-hostname 127.0.0.1",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "flutter build web --release --dart-define=FLUTTER_WEB_RENDERER=canvaskit",
    "frontendDist": "../build/web"
  },
  "app": {
    "windows": [
      {
        "title": "PetSpector",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}